{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/oferta",
      "destination": "/api/oferta"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      640,
      960,
      1280
    ],
    "qualities": [
      70,
      75
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "localPatterns": [
      {
        "pathname": "^/media/.*$",
        "search": ""
      }
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "iiem6jowmue3oprq.public.blob.vercel-storage.com",
        "pathname": "^/vsl/uploads/.*$"
      }
    ]
  }
}
